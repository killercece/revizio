# Variables d'environnement
# PORT=5000

# Module histoire-geo : proxy Claude pour generer/corriger les reponses
# PROXY_URL : endpoint du proxy compatible /v1/messages
PROXY_URL=http://10.0.0.40:8005/v1/messages
# PROXY_TOKEN : jeton d'authentification (Bearer). Ne JAMAIS exposer au navigateur.
PROXY_TOKEN=
# PROXY_MODEL : modele utilise pour la generation/correction
PROXY_MODEL=claude-sonnet-4-6
